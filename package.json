{
  "name": "spot-light-hd",
  "private": true,
  "version": "2.0.0",
  "description": "Spot-light HD: a realistic black lab chases your laser dot through a furnished room, a garden and a snowy cabin.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/finish-build.mjs",
    "check-build": "node scripts/finish-build.mjs --check",
    "test": "node --test 'src/*.test.js' && node tests/smoke.mjs",
    "test:unit": "node --test 'src/*.test.js'",
    "smoke": "node tests/smoke.mjs",
    "capture": "node scripts/capture.mjs"
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "playwright": "1.65.0",
    "vite": "8.3.8",
    "vite-plugin-singlefile": "2.3.4"
  }
}
